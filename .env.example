# Copiar a .env (NO se versiona). Una por VM; cambian NODE_ID, NODE_IP y AGENT_ID.
NODE_ID=1
NODE_IP=100.x.x.1                 # IP de Tailscale de ESTA VM (tailscale ip -4)
AGENT_ID=agent1
BROKER_HOST=100.x.x.3             # IP de Tailscale de la VM del broker (la de 3 GB)
COORDINATORS=1=100.x.x.1:50051,2=100.x.x.2:50051,3=100.x.x.3:50051
REDIS_PASSWORD=cambia-esta-clave-larga
RABBITMQ_USER=taller2
RABBITMQ_PASS=cambia-esta-otra-clave
